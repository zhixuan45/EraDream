; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="EraDream"
config/version="0.0.5"
run/main_scene="uid://c6587dhy1q4a"
config/features=PackedStringArray("4.6", "C#", "Mobile")
config/icon="res://icon.svg"

[autoload]

ResponsiveManager="*res://scripts/Core/ResponsiveManager.cs"
ErrorNotifier="*res://scripts/Core/ErrorNotifier.cs"
SettingsManager="*res://scripts/Core/SettingsManager.cs"
SettingsOverlay="*res://scripts/Core/SettingsOverlay.cs"
DebugConsole="*res://scenes/DebugConsole.tscn"
DesktopWindowChrome="*res://scripts/Core/DesktopWindowChrome.cs"
GameManager="*res://scripts/Game/GameManager.cs"
ExtensionManager="*res://scripts/Core/Extensions/ExtensionManager.cs"
ExtensionManagerUI="*res://scripts/Core/Extensions/ExtensionManagerUI.cs"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/mode=2
window/size/borderless=true
window/subwindows/embed_subwindows=false
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[dotnet]

project/assembly_name="EraDream"

[input_devices]

pointing/android/disable_scroll_deadzone=true

[internationalization]

locale/translations=PackedStringArray("res://translations/game_text.zh.translation", "res://translations/game_text.en.translation")

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
renderer/rendering_method="mobile"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
